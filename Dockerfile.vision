# ==============================================================================
# ROX2026 Vision & AI Container (D-Robotics RDK X5 / S100)
# Base: Ubuntu 22.04 + ROS 2 Humble + TROS
# ==============================================================================
# Note: For actual deployment on RDK hardware, use the official D-Robotics base image.
# For cross-building/testing on x86_64 or non-RDK platforms, this acts as a placeholder
# or uses a compatible base. Assuming we deploy on the actual RDK:

FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV ROS_DISTRO=humble

# 1. Install Basic Tools & ROS 2 Humble (Standard setup for Ubuntu 22.04)
RUN apt-get update && apt-get install -y curl gnupg2 lsb-release wget software-properties-common && \
    curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key -o /usr/share/keyrings/ros-archive-keyring.gpg && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] http://packages.ros.org/ros2/ubuntu $(lsb_release -cs) main" | tee /etc/apt/sources.list.d/ros2.list > /dev/null && \
    apt-get update && apt-get install -y \
    ros-${ROS_DISTRO}-ros-base \
    ros-${ROS_DISTRO}-rmw-cyclonedds-cpp \
    ros-${ROS_DISTRO}-rmw-fastrtps-cpp \
    python3-colcon-common-extensions \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# 2. Add D-Robotics APT Source & Install TROS Packages
# Using [trusted=yes] allows us to bypass missing GPG keys during image build
RUN echo 'deb [trusted=yes] http://archive.d-robotics.cc/ubuntu-rdk-x5 jammy main' | tee /etc/apt/sources.list.d/sunrise.list && \
    apt-get update && apt-get install -y \
    tros-humble-hobot-stereonet \
    tros-humble-mipi-cam \
    || echo "WARNING: TROS packages skipped (likely non-ARM64 build)."

WORKDIR /root/vision_ws

# 3. Setup Launch Script
COPY ./scripts/vision_entrypoint.sh /root/vision_entrypoint.sh
RUN chmod +x /root/vision_entrypoint.sh

# 4. Entrypoint
ENTRYPOINT ["/root/vision_entrypoint.sh"]
CMD ["bash"]
