<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="obstacle_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    
    <!-- Essential Systems for Physics and Collision -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <surface>
            <friction>
              <ode><mu>100</mu><mu2>100</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- The Big Red Wall -->
    <model name="big_wall">
      <pose>2.0 0 0.5 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="c">
          <geometry><box><size>0.2 5.0 1.0</size></box></geometry>
        </collision>
        <visual name="v">
          <geometry><box><size>0.2 5.0 1.0</size></box></geometry>
          <material><diffuse>1 0 0 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Random Obstacles (The "Stones") -->
    <model name="stone_2">
      <pose>1.5 -0.3 0.1 0 0 0</pose>
      <link name="link">
        <inertial><mass>0.5</mass></inertial>
        <collision name="c"><geometry><sphere><radius>0.1</radius></sphere></geometry></collision>
        <visual name="v"><geometry><sphere><radius>0.1</radius></sphere></geometry><material><diffuse>0.4 0.4 0.4 1</diffuse></material></visual>
      </link>
    </model>

    <model name="stone_3">
      <pose>0.8 -0.8 0.05 0 0 0</pose>
      <link name="link">
        <inertial><mass>0.2</mass></inertial>
        <collision name="c"><geometry><box><size>0.1 0.2 0.1</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.1 0.2 0.1</size></box></geometry><material><diffuse>0.3 0.3 0.3 1</diffuse></material></visual>
      </link>
    </model>

  </world>
</sdf>
