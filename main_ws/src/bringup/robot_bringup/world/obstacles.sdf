<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="obstacle_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    
    <!-- Physics Engine Core Systems -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics">
      <engine>
        <filename>libgz-physics-dartsim-plugin.so</filename>
      </engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <surface><friction><ode><mu>100</mu><mu2>100</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- THE ABSOLUTE BARRIER (5m Thick Fortress) -->
    <model name="big_wall">
      <pose>5.0 0 0.5 0 0 0</pose> <!-- Center at 5m, starts at 2.5m, ends at 7.5m -->
      <static>true</static>
      <link name="link">
        <collision name="c">
          <geometry><box><size>5.0 10.0 2.0</size></box></geometry>
          <surface>
            <contact><ode><kp>10000000.0</kp><min_depth>0.001</min_depth></ode></contact>
          </surface>
        </collision>
        <visual name="v">
          <geometry><box><size>5.0 10.0 2.0</size></box></geometry>
          <material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Moving Physical Box (Bumper Test) -->
    <model name="physical_box">
      <pose>1.5 0 0.1 0 0 0</pose>
      <link name="link">
        <inertial><mass>5.0</mass><inertia><ixx>0.1</ixx><iyy>0.1</iyy><izz>0.1</izz></inertia></inertial>
        <collision name="c"><geometry><box><size>0.5 0.5 0.2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.5 0.5 0.2</size></box></geometry><material><diffuse>0 1 0 1</diffuse></material></visual>
      </link>
    </model>

  </world>
</sdf>
