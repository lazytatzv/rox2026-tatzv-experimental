<?xml version="1.0"?>
<robot name="lazytatzv_robot">

  <!-- Materials -->
  <material name="blue"><color rgba="0 0 0.8 1"/></material>
  <material name="red"><color rgba="1 0 0 1"/></material>
  <material name="black"><color rgba="0 0 0 1"/></material>

  <!-- Base Footprint (The root, minimal physics) -->
  <link name="base_footprint">
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <!-- Base Link (The Physical Shell) -->
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="20.0"/> <!-- Heavier is better for stability -->
      <inertia ixx="0.5" ixy="0" ixz="0" iyy="0.5" iyz="0" izz="0.5"/>
    </inertial>
    <visual>
      <geometry><box size="0.3 0.2 0.1"/></geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <geometry><box size="0.3 0.2 0.1"/></geometry>
      <surface>
        <contact><ode><kp>1000000.0</kp><kd>1.0</kd><min_depth>0.001</min_depth></ode></contact>
      </surface>
    </collision>
  </link>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/><child link="base_link"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
  </joint>

  <!-- Wheels (High Grip Tires) -->
  <link name="front_left_wheel">
    <inertial><mass value="1.0"/><inertia ixx="0.005" ixy="0" ixz="0" iyy="0.005" iyz="0" izz="0.005"/></inertial>
    <visual><geometry><cylinder radius="0.05" length="0.04"/></geometry><material name="black"/></visual>
    <collision><geometry><cylinder radius="0.05" length="0.04"/></geometry></collision>
  </link>
  <joint name="front_left_wheel_joint" type="continuous">
    <parent link="base_link"/><child link="front_left_wheel"/>
    <origin xyz="0.12 0.10 0" rpy="-1.57 0 0"/><axis xyz="0 0 1"/>
    <dynamics damping="0.1" friction="0.1"/>
  </joint>

  <link name="front_right_wheel">
    <inertial><mass value="1.0"/><inertia ixx="0.005" ixy="0" ixz="0" iyy="0.005" iyz="0" izz="0.005"/></inertial>
    <visual><geometry><cylinder radius="0.05" length="0.04"/></geometry><material name="black"/></visual>
    <collision><geometry><cylinder radius="0.05" length="0.04"/></geometry></collision>
  </link>
  <joint name="front_right_wheel_joint" type="continuous">
    <parent link="base_link"/><child link="front_right_wheel"/>
    <origin xyz="0.12 -0.10 0" rpy="-1.57 0 0"/><axis xyz="0 0 1"/>
    <dynamics damping="0.1" friction="0.1"/>
  </joint>

  <link name="rear_left_wheel">
    <inertial><mass value="1.0"/><inertia ixx="0.005" ixy="0" ixz="0" iyy="0.005" iyz="0" izz="0.005"/></inertial>
    <visual><geometry><cylinder radius="0.05" length="0.04"/></geometry><material name="black"/></visual>
    <collision><geometry><cylinder radius="0.05" length="0.04"/></geometry></collision>
  </link>
  <joint name="rear_left_wheel_joint" type="continuous">
    <parent link="base_link"/><child link="rear_left_wheel"/>
    <origin xyz="-0.12 0.10 0" rpy="-1.57 0 0"/><axis xyz="0 0 1"/>
    <dynamics damping="0.1" friction="0.1"/>
  </joint>

  <link name="rear_right_wheel">
    <inertial><mass value="1.0"/><inertia ixx="0.005" ixy="0" ixz="0" iyy="0.005" iyz="0" izz="0.005"/></inertial>
    <visual><geometry><cylinder radius="0.05" length="0.04"/></geometry><material name="black"/></visual>
    <collision><geometry><cylinder radius="0.05" length="0.04"/></geometry></collision>
  </link>
  <joint name="rear_right_wheel_joint" type="continuous">
    <parent link="base_link"/><child link="rear_right_wheel"/>
    <origin xyz="-0.12 -0.10 0" rpy="-1.57 0 0"/><axis xyz="0 0 1"/>
    <dynamics damping="0.1" friction="0.1"/>
  </joint>

  <!-- Gazebo System Overrides -->
  <gazebo reference="front_left_wheel"><mu1>100.0</mu1><mu2>100.0</mu2></gazebo>
  <gazebo reference="front_right_wheel"><mu1>100.0</mu1><mu2>100.0</mu2></gazebo>
  <gazebo reference="rear_left_wheel"><mu1>100.0</mu1><mu2>100.0</mu2></gazebo>
  <gazebo reference="rear_right_wheel"><mu1>100.0</mu1><mu2>100.0</mu2></gazebo>

  <gazebo>
    <plugin filename="gz-sim-mecanum-drive-system" name="gz::sim::systems::MecanumDrive">
      <front_left_joint>front_left_wheel_joint</front_left_joint>
      <front_right_joint>front_right_wheel_joint</front_right_joint>
      <back_left_joint>rear_left_wheel_joint</back_left_joint>
      <back_right_joint>rear_right_wheel_joint</back_right_joint>
      <wheel_separation>0.20</wheel_separation>
      <wheel_radius>0.05</wheel_radius>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
    </plugin>
  </gazebo>

</robot>
