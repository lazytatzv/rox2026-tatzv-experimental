<?xml version="1.0"?>
<robot name="lazytatzv_robot">

  <!-- Materials -->
  <material name="blue"><color rgba="0 0 0.8 1"/></material>
  <material name="red"><color rgba="1 0 0 1"/></material>
  <material name="black"><color rgba="0 0 0 1"/></material>

  <link name="base_footprint"/>

  <!-- Base Link (Industrial High-Clearance Body) -->
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="20.0"/>
      <inertia ixx="0.5" ixy="0" ixz="0" iyy="1.0" iyz="0" izz="1.0"/>
    </inertial>
    <visual><geometry><box size="0.4 0.3 0.15"/></geometry><material name="blue"/></visual>
    <visual><origin xyz="0.20 0 0.08" rpy="0 0 0"/><geometry><box size="0.05 0.05 0.05"/></geometry><material name="red"/></visual>
    <collision><geometry><box size="0.4 0.3 0.15"/></geometry></collision>
  </link>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/><child link="base_link"/>
    <origin xyz="0 0 0.15" rpy="0 0 0"/> <!-- Chassis floor is at 0.075, plenty of clearance -->
  </joint>

  <!-- Wheels - Large Diameter (10cm radius) -->
  <!-- Sphere collision for point-contact stability -->
  
  <link name="front_left_wheel">
    <inertial><mass value="2.0"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/></inertial>
    <visual><origin xyz="0 0 0" rpy="1.57 0 0"/><geometry><cylinder radius="0.10" length="0.06"/></geometry><material name="black"/></visual>
    <collision><geometry><sphere radius="0.10"/></geometry></collision>
  </link>
  <joint name="front_left_wheel_joint" type="continuous">
    <parent link="base_link"/><child link="front_left_wheel"/>
    <origin xyz="0.15 0.20 -0.05" rpy="0 0 0"/><axis xyz="0 1 0"/> <!-- Center at z=0.10 -->
    <dynamics damping="0.1" friction="0.1"/>
  </joint>

  <link name="front_right_wheel">
    <inertial><mass value="2.0"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/></inertial>
    <visual><origin xyz="0 0 0" rpy="1.57 0 0"/><geometry><cylinder radius="0.10" length="0.06"/></geometry><material name="black"/></visual>
    <collision><geometry><sphere radius="0.10"/></geometry></collision>
  </link>
  <joint name="front_right_wheel_joint" type="continuous">
    <parent link="base_link"/><child link="front_right_wheel"/>
    <origin xyz="0.15 -0.20 -0.05" rpy="0 0 0"/><axis xyz="0 1 0"/>
    <dynamics damping="0.1" friction="0.1"/>
  </joint>

  <link name="rear_left_wheel">
    <inertial><mass value="2.0"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/></inertial>
    <visual><origin xyz="0 0 0" rpy="1.57 0 0"/><geometry><cylinder radius="0.10" length="0.06"/></geometry><material name="black"/></visual>
    <collision><geometry><sphere radius="0.10"/></geometry></collision>
  </link>
  <joint name="rear_left_wheel_joint" type="continuous">
    <parent link="base_link"/><child link="rear_left_wheel"/>
    <origin xyz="-0.15 0.20 -0.05" rpy="0 0 0"/><axis xyz="0 1 0"/>
    <dynamics damping="0.1" friction="0.1"/>
  </joint>

  <link name="rear_right_wheel">
    <inertial><mass value="2.0"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/></inertial>
    <visual><origin xyz="0 0 0" rpy="1.57 0 0"/><geometry><cylinder radius="0.10" length="0.06"/></geometry><material name="black"/></visual>
    <collision><geometry><sphere radius="0.10"/></geometry></collision>
  </link>
  <joint name="rear_right_wheel_joint" type="continuous">
    <parent link="base_link"/><child link="rear_right_wheel"/>
    <origin xyz="-0.15 -0.20 -0.05" rpy="0 0 0"/><axis xyz="0 1 0"/>
    <dynamics damping="0.1" friction="0.1"/>
  </joint>

  <!-- Gazebo Physics - ANISOTROPIC FRICTION -->
  <!-- Low mu1 for sliding, High mu2 for traction -->
  <gazebo reference="front_left_wheel"><mu1>0.0</mu1><mu2>1.0</mu2><fdir1>1 1 0</fdir1></gazebo>
  <gazebo reference="front_right_wheel"><mu1>0.0</mu1><mu2>1.0</mu2><fdir1>1 -1 0</fdir1></gazebo>
  <gazebo reference="rear_left_wheel"><mu1>0.0</mu1><mu2>1.0</mu2><fdir1>1 -1 0</fdir1></gazebo>
  <gazebo reference="rear_right_wheel"><mu1>0.0</mu1><mu2>1.0</mu2><fdir1>1 1 0</fdir1></gazebo>

  <gazebo>
    <plugin filename="gz-sim-mecanum-drive-system" name="gz::sim::systems::MecanumDrive">
      <front_left_joint>front_left_wheel_joint</front_left_joint>
      <front_right_joint>front_right_wheel_joint</front_right_joint>
      <back_left_joint>rear_left_wheel_joint</back_left_joint>
      <back_right_joint>rear_right_wheel_joint</back_right_joint>
      <!-- Updated Geometry Parameters -->
      <wheel_separation>0.40</wheel_separation>
      <wheel_base>0.30</wheel_base>
      <wheel_radius>0.10</wheel_radius>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <!-- UNLEASH TORQUE -->
      <max_wheel_torque>500.0</max_wheel_torque>
      <max_wheel_velocity>30.0</max_wheel_velocity>
    </plugin>
  </gazebo>

</robot>
