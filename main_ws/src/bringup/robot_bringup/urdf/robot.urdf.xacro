<?xml version="1.0"?>
<robot name="nexus_mecanum_robstride" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Section 1: Physical Specs (Robstride + Nexus) -->
  <xacro:property name="base_mass"    value="5.0"/>
  <xacro:property name="wheel_mass"   value="0.63"/>
  <xacro:property name="wheel_radius" value="0.05"/>
  <xacro:property name="wheel_width"  value="0.05"/>
  <xacro:property name="wheel_base"   value="0.25"/>
  <xacro:property name="wheel_sep"    value="0.30"/>

  <material name="blue"><color rgba="0 0 0.8 1"/></material>
  <material name="black"><color rgba="0.1 0.1 0.1 1"/></material>

  <!-- Section 2: Links & Joints -->
  <!-- FIXED: base_footprint MUST have inertia in Gz Sim Harmonic -->
  <link name="base_footprint">
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>
  
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${base_mass}"/>
      <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.2"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry><box size="0.36 0.30 0.06"/></geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry><box size="0.36 0.30 0.06"/></geometry>
    </collision>
  </link>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/><child link="base_link"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
  </joint>

  <!-- Wheel Macro -->
  <xacro:macro name="nexus_wheel" params="side position x_sign y_sign fdir">
    <link name="${side}_${position}_wheel">
      <inertial>
        <mass value="${wheel_mass}"/>
        <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.002"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="1.57 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="1.57 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
    </link>

    <joint name="${side}_${position}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${side}_${position}_wheel"/>
      <origin xyz="${x_sign * wheel_base/2} ${y_sign * wheel_sep/2} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.1" friction="0.05"/>
    </joint>

    <gazebo reference="${side}_${position}_wheel">
        <mu1>0.01</mu1><mu2>1.0</mu2>
        <fdir1>${fdir}</fdir1>
    </gazebo>
  </xacro:macro>

  <xacro:nexus_wheel side="front" position="left"  x_sign="1"  y_sign="1"  fdir="1 1 0"/>
  <xacro:nexus_wheel side="front" position="right" x_sign="1"  y_sign="-1" fdir="1 -1 0"/>
  <xacro:nexus_wheel side="rear"  position="left"  x_sign="-1" y_sign="1"  fdir="1 -1 0"/>
  <xacro:nexus_wheel side="rear"  position="right" x_sign="-1" y_sign="-1" fdir="1 1 0"/>

  <gazebo>
    <plugin filename="gz-sim-mecanum-drive-system" name="gz::sim::systems::MecanumDrive">
      <front_left_joint>front_left_wheel_joint</front_left_joint>
      <front_right_joint>front_right_wheel_joint</front_right_joint>
      <back_left_joint>rear_left_wheel_joint</back_left_joint>
      <back_right_joint>rear_right_wheel_joint</back_right_joint>
      <wheel_separation>${wheel_sep}</wheel_separation>
      <wheel_base>${wheel_base}</wheel_base>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <!-- Robstride Power Specs -->
      <max_wheel_torque>10.0</max_wheel_torque>
      <max_wheel_velocity>40.0</max_wheel_velocity>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/joint_states</topic>
    </plugin>
  </gazebo>

</robot>
