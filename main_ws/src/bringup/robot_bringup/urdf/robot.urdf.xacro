<?xml version="1.0"?>
<robot name="nexus_10011_optimized" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Section 1: Specs -->
  <xacro:property name="base_mass"    value="3.0"/>
  <xacro:property name="wheel_mass"   value="0.4"/>
  <xacro:property name="wheel_radius" value="0.05"/>
  <xacro:property name="wheel_width"  value="0.05"/>
  <xacro:property name="wheel_base"   value="0.25"/>
  <xacro:property name="wheel_sep"    value="0.30"/>

  <material name="nexus_yellow"><color rgba="1.0 0.8 0.0 1"/></material>
  <material name="aluminum"><color rgba="0.8 0.8 0.8 1"/></material>
  <material name="black"><color rgba="0.1 0.1 0.1 1"/></material>

  <link name="base_footprint">
    <inertial><mass value="0.01"/><inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/></inertial>
  </link>
  
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${base_mass}"/>
      <inertia ixx="0.05" ixy="0" ixz="0" iyy="0.05" iyz="0" izz="0.1"/>
    </inertial>
    <visual><origin xyz="0 0 0.03"/><geometry><box size="0.36 0.249 0.06"/></geometry><material name="nexus_yellow"/></visual>
    <collision><origin xyz="0 0 0.03"/><geometry><box size="0.36 0.249 0.06"/></geometry></collision>
  </link>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/><child link="base_link"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
  </joint>

  <!-- --- VISUAL-ONLY ROLLER MACRO (No Physics, Pure Beauty) --- -->
  <xacro:macro name="roller_visual" params="angle_deg roller_type">
    <visual>
      <origin xyz="${0.04 * cos(radians(angle_deg))} ${0.04 * sin(radians(angle_deg))} 0" 
              rpy="${roller_type * pi/4} 0 ${radians(angle_deg)}"/>
      <geometry><cylinder radius="0.012" length="0.035"/></geometry>
      <material name="black"/>
    </visual>
  </xacro:macro>

  <!-- --- THE OPTIMIZED MECANUM WHEEL MACRO --- -->
  <xacro:macro name="pro_mecanum_wheel" params="side position x_sign y_sign roller_type fdir">
    <link name="${side}_${position}_wheel">
      <inertial>
        <mass value="${wheel_mass}"/>
        <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
      </inertial>
      <!-- Hub Plates -->
      <visual><origin rpy="0 0 0"/><geometry><cylinder radius="0.04" length="0.005"/></geometry><material name="aluminum"/></visual>
      <visual><origin xyz="0 0 0.02"/><geometry><cylinder radius="0.04" length="0.005"/></geometry><material name="aluminum"/></visual>
      <visual><origin xyz="0 0 -0.02"/><geometry><cylinder radius="0.04" length="0.005"/></geometry><material name="aluminum"/></visual>
      
      <!-- Visual Rollers (No joints = Zero CPU load) -->
      <xacro:roller_visual angle_deg="0"   roller_type="${roller_type}"/>
      <xacro:roller_visual angle_deg="40"  roller_type="${roller_type}"/>
      <xacro:roller_visual angle_deg="80"  roller_type="${roller_type}"/>
      <xacro:roller_visual angle_deg="120" roller_type="${roller_type}"/>
      <xacro:roller_visual angle_deg="160" roller_type="${roller_type}"/>
      <xacro:roller_visual angle_deg="200" roller_type="${roller_type}"/>
      <xacro:roller_visual angle_deg="240" roller_type="${roller_type}"/>
      <xacro:roller_visual angle_deg="280" roller_type="${roller_type}"/>
      <xacro:roller_visual angle_deg="320" roller_type="${roller_type}"/>

      <!-- Single Sphere Collision (Fastest possible physics) -->
      <collision>
        <geometry><sphere radius="${wheel_radius}"/></geometry>
      </collision>
    </link>

    <joint name="${side}_${position}_wheel_joint" type="continuous">
      <parent link="base_link"/><child link="${side}_${position}_wheel"/>
      <origin xyz="${x_sign * wheel_base/2} ${y_sign * wheel_sep/2} 0" rpy="-1.57 0 0"/>
      <axis xyz="0 0 1"/>
      <dynamics damping="0.05" friction="0.02"/>
    </joint>

    <gazebo reference="${side}_${position}_wheel">
        <!-- THE PERFORMANCE SECRET: mu1=0.0 on roller axis emulates the physical rollers -->
        <mu1>0.01</mu1><mu2>1.0</mu2>
        <fdir1>${fdir}</fdir1>
        <min_depth>0.001</min_depth>
    </gazebo>
  </xacro:macro>

  <xacro:pro_mecanum_wheel side="front" position="left"  x_sign="1"  y_sign="1"  roller_type="-1" fdir="1 -1 0"/>
  <xacro:pro_mecanum_wheel side="front" position="right" x_sign="1"  y_sign="-1" roller_type="1"  fdir="1 1 0"/>
  <xacro:pro_mecanum_wheel side="rear"  position="left"  x_sign="-1" y_sign="1"  roller_type="1"  fdir="1 1 0"/>
  <xacro:pro_mecanum_wheel side="rear"  position="right" x_sign="-1" y_sign="-1" roller_type="-1" fdir="1 -1 0"/>

  <gazebo>
    <plugin filename="gz-sim-mecanum-drive-system" name="gz::sim::systems::MecanumDrive">
      <front_left_joint>front_left_wheel_joint</front_left_joint>
      <front_right_joint>front_right_wheel_joint</front_right_joint>
      <back_left_joint>rear_left_wheel_joint</back_left_joint>
      <back_right_joint>rear_right_wheel_joint</back_right_joint>
      <wheel_separation>${wheel_sep}</wheel_separation>
      <wheel_base>${wheel_base}</wheel_base>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <max_wheel_torque>5.0</max_wheel_torque>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/joint_states</topic>
    </plugin>
  </gazebo>

</robot>
