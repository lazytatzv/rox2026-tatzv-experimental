# ROS 2 Workspace Justfile

export ROS_SETUP := "/opt/ros/jazzy/setup.bash"

# Detect if we are inside the container
is_container := `if [ -f /opt/ros/jazzy/setup.bash ]; then echo "yes"; else echo "no"; fi`

@default:
    just --list

# Build all packages
build:
    @if [ "{{is_container}}" = "yes" ]; then \
        bash -c 'source {{ROS_SETUP}} && colcon build --symlink-install --parallel-workers $(nproc || echo 2) --cmake-args -DCMAKE_BUILD_TYPE=Release'; \
    else \
        echo "Not in container. Forwarding..."; \
        cd .. && just build; \
    fi

# Run all tests
test:
    @if [ "{{is_container}}" = "yes" ]; then \
        bash -c 'source {{ROS_SETUP}} && source install/setup.bash 2>/dev/null || true && colcon test --event-handlers console_direct+'; \
    else \
        echo "Not in container. Forwarding..."; \
        cd .. && docker compose exec ros2_rox2026 just -f main_ws/Justfile test; \
    fi

# Launch headless simulation
sim:
    @if [ "{{is_container}}" = "yes" ]; then \
        bash -c 'source {{ROS_SETUP}} && source install/setup.bash 2>/dev/null || true && ros2 launch robot_bringup robot_bringup.launch.py gazebo:=true headless:=true use_sim_time:=true'; \
    else \
        echo "Not in container. Forwarding..."; \
        cd .. && docker compose exec ros2_rox2026 just -f main_ws/Justfile sim; \
    fi

# Launch Gazebo simulation with GUI
sim-gui:
    @if [ "{{is_container}}" = "yes" ]; then \
        echo "Skipping pkill cleanup..."; \
        bash -c 'source {{ROS_SETUP}} && source install/setup.bash 2>/dev/null || true && ros2 launch robot_bringup robot_bringup.launch.py gazebo:=true headless:=false use_sim_time:=true'; \
    else \
        echo "Not in container. Forwarding..."; \
        cd .. && docker compose exec ros2_rox2026 just -f main_ws/Justfile sim-gui; \
    fi

# Launch physical robot
launch:
    @if [ "{{is_container}}" = "yes" ]; then \
        bash -c 'source {{ROS_SETUP}} && source install/setup.bash 2>/dev/null || true && ros2 launch robot_bringup robot_bringup.launch.py'; \
    else \
        echo "Not in container. Forwarding..."; \
        cd .. && docker compose exec ros2_rox2026 just -f main_ws/Justfile launch; \
    fi

# Launch minimal teleop-only (no sensors, no Nav2, just mecanum + joystick)
teleop:
    @if [ "{{is_container}}" = "yes" ]; then \
        bash -c 'source {{ROS_SETUP}} && source install/setup.bash 2>/dev/null || true && ros2 launch robot_bringup teleop_only.launch.py'; \
    else \
        echo "Not in container. Forwarding..."; \
        cd .. && docker compose exec ros2_rox2026 just -f main_ws/Justfile teleop; \
    fi

# Run automated control engineering analysis (mode can be step, sine, chirp, auto)
analyze-control mode="auto" bag="control_analysis_bag" report="full_analysis_report":
    @if [ "{{is_container}}" = "yes" ]; then \
        rm -rf {{bag}} reports && mkdir -p reports && \
        echo "Starting control analysis launch (recording & injecting, mode: {{mode}})..." && \
        bash -c 'source {{ROS_SETUP}} && source install/setup.bash 2>/dev/null || true && ros2 launch control_analysis control_analysis.launch.py mode:={{mode}} bag_name:={{bag}} use_sim_time:=true' || true; \
        echo "Launch finished. Waiting for bag file to flush..." && sleep 2 && \
        echo "Running professional control engineering analysis on {{bag}}..." && \
        bash -c 'source {{ROS_SETUP}} && source install/setup.bash 2>/dev/null || true && ros2 run control_analysis analyze {{bag}} {{report}} reports'; \
    else \
        echo "Not in container. Forwarding..."; \
        cd .. && docker compose exec ros2_rox2026 just -f main_ws/Justfile analyze-control {{mode}} {{bag}} {{report}}; \
    fi

# Alias for README compatibility
report mode="auto" bag="control_analysis_bag" report_name="full_analysis_report":
    @just analyze-control {{mode}} {{bag}} {{report_name}}

# Purge artifacts
clean:
    @if [ "{{is_container}}" = "yes" ]; then \
        rm -rf build/ install/ log/; \
    else \
        echo "Not in container. Forwarding..."; \
        cd .. && docker compose exec ros2_rox2026 just -f main_ws/Justfile clean; \
    fi

# Generate high-resolution system architecture diagram (docs/packages.png)
generate-diag:
    python3 generate_packages_png.py
